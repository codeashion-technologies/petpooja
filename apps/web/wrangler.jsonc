{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orderrestro-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "vars": {
    "BACKEND_URL": "https://nodedr-restaurantbackend-production.up.railway.app"
  }
}

